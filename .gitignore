# Secrets / env
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / agent-browser
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Pipeline data (potentially sensitive vendor/customer info)
data/input/*
data/output/*
!data/input/.gitkeep
!data/output/.gitkeep

# Run artifacts
logs/
!logs/.gitkeep
*.log
*.har

# Browser automation artifacts
.agent-browser/
screenshots/
downloads/
trace/
*.crdownload

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Build / temp
dist/
build/
tmp/
*.tmp
*.bak
